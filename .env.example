# Telegram config (required by messaging.py)
TELEGRAM_RECEIVER_ID="YOUR_TELEGRAM_CHAT_ID"

# Specific channels used by the app
TELEGRAM_BOT_TOKEN_CH0="YOUR_TOKEN_FOR_CHANNEL_0"
TELEGRAM_BOT_TOKEN_CH1="YOUR_TOKEN_FOR_CHANNEL_1"
TELEGRAM_BOT_TOKEN_CH2="YOUR_TOKEN_FOR_CHANNEL_2"
TELEGRAM_BOT_TOKEN_CH3="YOUR_TOKEN_FOR_CHANNEL_3"
TELEGRAM_BOT_TOKEN_CH4="YOUR_TOKEN_FOR_CHANNEL_4"
TELEGRAM_BOT_TOKEN_CH5="YOUR_TOKEN_FOR_CHANNEL_5"

# Optional fallback token for unknown channels
TELEGRAM_BOT_TOKEN_DEFAULT="YOUR_FALLBACK_TOKEN"

# Backend runtime
# Relative paths are resolved from the project root, not from the shell folder.
ANALYSES_DIR="analyses"
LOGS_DIR="logs"
FRONTEND_DIST_DIR="frontend/dist"
CORS_ORIGINS=""
